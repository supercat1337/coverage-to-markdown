{
    "compilerOptions": {
        "checkJs": true,
        "allowJs": true,
        "target": "es2022",
        "lib": ["es2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "exclude": ["node_modules/**", "coverage", "bundles", "tests"],
    "include": ["src/**/*.js", "tests/**/*.js"]
}
