{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "target": "es2022",
        "lib": ["es2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src/**/*.js"],
    "exclude": ["node_modules/*", "tests/*"]
}
